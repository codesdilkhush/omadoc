[Desktop Entry]
Type=Application
Name=Omadoc
Comment=Fast and minimal document reader
Exec=omadoc %f
Icon=omadoc
Terminal=false
Categories=Office;Viewer;Graphics;
MimeType=application/pdf;application/epub+zip;application/x-cbr;application/x-cbz;application/x-cbt;application/x-cb7;application/vnd.comicbook+zip;application/vnd.comicbook-rar;
StartupWMClass=omadoc
