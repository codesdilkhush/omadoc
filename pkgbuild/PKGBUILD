pkgname=omadoc
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast, lightweight document viewer for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'poppler')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omadoc "$pkgdir/usr/bin/omadoc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omadoc.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omadoc.svg"
  install -Dm644 "$startdir/omadoc.desktop" "$pkgdir/usr/share/applications/omadoc.desktop"
}
